@model EcommerceMVC.Models.ProductReview

@{
    ViewBag.Title = "Write Review";
    var product = ViewBag.Product as EcommerceMVC.Models.Product;
}

<div class="page-header">
    <h2><i class="bi bi-pencil"></i> Write a Review</h2>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">@Html.ActionLink("Products", "Index", "Products")</li>
            <li class="breadcrumb-item">@Html.ActionLink(product.ProductName, "Details", "Products", new { id = product.ProductID }, null)</li>
            <li class="breadcrumb-item">@Html.ActionLink("Reviews", "Product", new { id = product.ProductID })</li>
            <li class="breadcrumb-item active">Write Review</li>
        </ol>
    </nav>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0">Your Review for @product.ProductName</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("Create", "Reviews", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                    @Html.HiddenFor(m => m.ProductID)

                    <div class="mb-3">
                        <label class="form-label">Rating *</label>
                        <div class="rating-input">
                            @for (int i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="Rating" value="@i" id="star@i" required>
                                <label for="star@i" class="star-label">
                                    <i class="bi bi-star-fill"></i>
                                </label>
                            }
                        </div>
                        <small class="form-text text-muted">Click on the stars to rate this product</small>
                        @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Review Title *</label>
                        @Html.TextBoxFor(m => m.ReviewTitle, new { @class = "form-control", placeholder = "Summarize your review in a few words", required = "required" })
                        @Html.ValidationMessageFor(m => m.ReviewTitle, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Your Review</label>
                        @Html.TextAreaFor(m => m.ReviewText, new { @class = "form-control", rows = "5", placeholder = "Tell others about your experience with this product..." })
                        @Html.ValidationMessageFor(m => m.ReviewText, "", new { @class = "text-danger small" })
                        <small class="form-text text-muted">Optional: Share details about what you liked or didn't like</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Submit Review
                        </button>
                        <a href="@Url.Action("Details", "Products", new { id = product.ProductID })" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Product Info Sidebar -->
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" alt="@product.ProductName" class="img-fluid mb-3 rounded">
                }
                <h5>@product.ProductName</h5>
                <p class="text-muted mb-2">SKU: @product.SKU</p>
                <h4 class="text-success mb-3">$@product.Price.ToString("N2")</h4>
                
                @if (product.ReviewCount > 0)
                {
                    <div class="mb-3">
                        <div class="text-warning mb-1">
                            @Html.Raw(product.StarRatingDisplay)
                        </div>
                        <small class="text-muted">@product.AverageRating.ToString("N1") out of 5 (@product.ReviewCount reviews)</small>
                    </div>
                }
                
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    <strong>Review Guidelines:</strong>
                    <ul class="mb-0 mt-2">
                        <li>Be honest and helpful</li>
                        <li>Focus on the product features</li>
                        <li>Keep it respectful</li>
                        <li>Avoid personal information</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .rating-input {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 5px;
        margin-bottom: 10px;
    }

    .rating-input input[type="radio"] {
        display: none;
    }

    .star-label {
        font-size: 2rem;
        color: #ddd;
        cursor: pointer;
        transition: color 0.2s;
    }

    .rating-input input[type="radio"]:checked ~ .star-label,
    .rating-input input[type="radio"]:hover ~ .star-label,
    .star-label:hover {
        color: #ffc107;
    }

    .rating-input:hover .star-label {
        color: #ddd;
    }

    .rating-input .star-label:hover ~ .star-label {
        color: #ffc107;
    }
</style>

<script>
    $(document).ready(function() {
        // Rating interaction
        $('.star-label').on('mouseenter', function() {
            var rating = $(this).prev('input').val();
            highlightStars(rating);
        });

        $('.rating-input').on('mouseleave', function() {
            var checkedRating = $('input[name="Rating"]:checked').val();
            if (checkedRating) {
                highlightStars(checkedRating);
            } else {
                $('.star-label').removeClass('text-warning').addClass('text-muted');
            }
        });

        $('input[name="Rating"]').on('change', function() {
            var rating = $(this).val();
            highlightStars(rating);
        });

        function highlightStars(rating) {
            $('.star-label').each(function(index) {
                var starValue = $(this).prev('input').val();
                if (starValue <= rating) {
                    $(this).removeClass('text-muted').addClass('text-warning');
                } else {
                    $(this).removeClass('text-warning').addClass('text-muted');
                }
            });
        }
    });
</script>