@model EcommerceMVC.Models.ShoppingCart

@{
    ViewBag.Title = "Shopping Cart";
}

<div class="page-header">
    <h2><i class="bi bi-cart3"></i> Shopping Cart</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Items.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-cart-x" style="font-size: 5rem; color: #cbd5e1;"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Add some products to get started!</p>
            <a href="@Url.Action("Index", "Shop")" class="btn btn-primary mt-3">
                <i class="bi bi-shop"></i> Continue Shopping
            </a>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                                            {
                                                <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" class="me-3" />
                                            }
                                            <div>
                                                <strong>@item.ProductName</strong><br />
                                                <small class="text-muted">SKU: @item.SKU</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <strong>$@item.Price.ToString("N2")</strong>
                                    </td>
                                    <td class="align-middle">
                                        @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductID" />
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="99" class="form-control form-control-sm" style="width: 80px;" onchange="this.form.submit()" />
                                        }
                                    </td>
                                    <td class="align-middle">
                                        <strong class="text-success">$@item.Subtotal.ToString("N2")</strong>
                                    </td>
                                    <td class="align-middle">
                                        @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductID" />
                                            <button type="submit" class="btn btn-sm btn-danger" title="Remove">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="mt-3">
                <a href="@Url.Action("Index", "Shop")" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> Continue Shopping
                </a>
                <a href="@Url.Action("Clear", "Cart")" class="btn btn-outline-danger">
                    <i class="bi bi-trash"></i> Clear Cart
                </a>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Order Summary</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal:</span>
                        <strong>$@Model.GetTotal().ToString("N2")</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tax (8.5%):</span>
                        <strong>$@((Model.GetTotal() * 0.085m).ToString("N2"))</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping:</span>
                        <strong>@(Model.GetTotal() >= 100 ? "FREE" : "$9.99")</strong>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between mb-3">
                        <strong>Total:</strong>
                        <h4 class="text-success mb-0">$@((Model.GetTotal() + (Model.GetTotal() * 0.085m) + (Model.GetTotal() >= 100 ? 0 : 9.99m)).ToString("N2"))</h4>
                    </div>
                    
                    @if (Model.GetTotal() < 100)
                    {
                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle"></i> Add $@((100 - Model.GetTotal()).ToString("N2")) more for FREE shipping!
                        </div>
                    }
                    
                    <a href="@Url.Action("Index", "Checkout")" class="btn btn-success w-100 btn-lg">
                        <i class="bi bi-credit-card"></i> Proceed to Checkout
                    </a>
                </div>
            </div>
        </div>
    </div>
}
