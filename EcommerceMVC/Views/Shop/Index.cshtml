@model IEnumerable<EcommerceMVC.Models.Product>

@{
    ViewBag.Title = "Shop";
}

<div class="page-header">
    <h2><i class="bi bi-shop-window"></i> Shop Products</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search and Filter Section -->
<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Index")" class="row g-3">
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-search"></i> Search</label>
                <input type="text" name="search" class="form-control" placeholder="Product name or SKU..." value="@ViewBag.Search" />
            </div>
            <div class="col-md-3">
                <label class="form-label"><i class="bi bi-tag"></i> Category</label>
                <select name="categoryId" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var cat in ViewBag.Categories as List<EcommerceMVC.Models.Category>)
                    {
                        <option value="@cat.CategoryID" @(ViewBag.CategoryId == cat.CategoryID ? "selected" : "")>@cat.CategoryName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Min Price</label>
                <input type="number" name="minPrice" class="form-control" placeholder="$0" value="@ViewBag.MinPrice" step="0.01" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Max Price</label>
                <input type="number" name="maxPrice" class="form-control" placeholder="$999" value="@ViewBag.MaxPrice" step="0.01" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<p class="text-muted mb-3">
    <i class="bi bi-info-circle"></i> Found <strong>@ViewBag.ResultCount</strong> products
</p>

<!-- Products Grid -->
<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 product-card">
                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" class="card-img-top product-card-img" alt="@product.ProductName" />
                }
                else
                {
                    <div class="card-img-top product-placeholder">
                        <i class="bi bi-box"></i>
                    </div>
                }
                <div class="card-body d-flex flex-column">
                    <h6 class="card-title">@product.ProductName</h6>
                    <p class="card-text text-muted small">@product.Category.CategoryName</p>
                    <p class="card-text flex-grow-1">
                        <small>@(product.Description != null && product.Description.Length > 80 ? product.Description.Substring(0, 80) + "..." : product.Description)</small>
                    </p>
                    <div class="d-flex justify-content-between align-items-center mt-auto">
                        <h5 class="text-success mb-0">$@product.Price.ToString("N2")</h5>
                        @using (Html.BeginForm("Add", "Cart", FormMethod.Post, new { @class = "d-inline" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.ProductID" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-sm btn-primary">
                                <i class="bi bi-cart-plus"></i> Add
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Pagination Controls -->
@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Product pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (ViewBag.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        search = ViewBag.Search, 
                        categoryId = ViewBag.CategoryId, 
                        minPrice = ViewBag.MinPrice, 
                        maxPrice = ViewBag.MaxPrice, 
                        page = ViewBag.CurrentPage - 1 
                    })">
                        <i class="bi bi-chevron-left"></i> Previous
                    </a>
                </li>
            }
            
            @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        search = ViewBag.Search, 
                        categoryId = ViewBag.CategoryId, 
                        minPrice = ViewBag.MinPrice, 
                        maxPrice = ViewBag.MaxPrice, 
                        page = i 
                    })">@i</a>
                </li>
            }
            
            @if (ViewBag.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" href="@Url.Action("Index", new { 
                        search = ViewBag.Search, 
                        categoryId = ViewBag.CategoryId, 
                        minPrice = ViewBag.MinPrice, 
                        maxPrice = ViewBag.MaxPrice, 
                        page = ViewBag.CurrentPage + 1 
                    })">
                        Next <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            }
        </ul>
    </nav>
    
    <div class="text-center text-muted">
        <small>
            Showing @((ViewBag.CurrentPage - 1) * 20 + 1) to @(Math.Min(ViewBag.CurrentPage * 20, ViewBag.ResultCount)) 
            of @ViewBag.ResultCount products
        </small>
    </div>
}

<style>
    .product-card {
        transition: all 0.3s ease;
    }
    
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    }
    
    .product-card-img {
        height: 200px;
        object-fit: cover;
    }
    
    .product-placeholder {
        height: 200px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 4rem;
    }
</style>
