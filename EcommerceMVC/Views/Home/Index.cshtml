@{
    ViewBag.Title = "Dashboard";
}

<div class="jumbotron mt-4">
    <h1 class="display-4"><i class="bi bi-speedometer2"></i> E-commerce Management System</h1>
    <p class="lead">Welcome to your E-commerce Management Dashboard</p>
    <hr class="my-4">
    <p><i class="bi bi-info-circle"></i> Built with ASP.NET MVC (.NET Framework 4.8) - Ready for modernization to .NET Core</p>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card stats-card primary mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Total Customers</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.TotalCustomers</h2>
                    </div>
                    <div class="text-primary" style="font-size: 3rem; opacity: 0.3;">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="@Url.Action("Index", "Customers")" class="btn btn-sm btn-primary">
                        <i class="bi bi-arrow-right"></i> View All
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card stats-card success mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Total Products</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.TotalProducts</h2>
                    </div>
                    <div class="text-success" style="font-size: 3rem; opacity: 0.3;">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="@Url.Action("Index", "Products")" class="btn btn-sm btn-success">
                        <i class="bi bi-arrow-right"></i> View All
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card stats-card info mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Total Orders</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.TotalOrders</h2>
                    </div>
                    <div class="text-info" style="font-size: 3rem; opacity: 0.3;">
                        <i class="bi bi-cart-check-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <a href="@Url.Action("Index", "Orders")" class="btn btn-sm btn-info">
                        <i class="bi bi-arrow-right"></i> View All
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card stats-card warning mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-2">Active Products</h6>
                        <h2 class="mb-0 fw-bold">@ViewBag.ActiveProducts</h2>
                    </div>
                    <div class="text-warning" style="font-size: 3rem; opacity: 0.3;">
                        <i class="bi bi-star-fill"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="badge bg-warning">Currently Available</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-lightning-charge"></i> Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="d-flex gap-3 flex-wrap">
                    <a href="@Url.Action("Create", "Customers")" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Add New Customer
                    </a>
                    <a href="@Url.Action("Create", "Products")" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Add New Product
                    </a>
                    <a href="@Url.Action("Index", "Orders")" class="btn btn-info">
                        <i class="bi bi-cart-plus"></i> View Orders
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> About This Application</h5>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Technology Stack:</strong></p>
                <ul class="list-unstyled">
                    <li><i class="bi bi-check-circle-fill text-success"></i> ASP.NET MVC 5 (.NET Framework 4.8)</li>
                    <li><i class="bi bi-check-circle-fill text-success"></i> Entity Framework 6</li>
                    <li><i class="bi bi-check-circle-fill text-success"></i> SQL Server Database</li>
                    <li><i class="bi bi-check-circle-fill text-success"></i> Bootstrap 5 UI</li>
                </ul>
                <p class="mt-3 mb-0 text-muted">
                    <i class="bi bi-arrow-repeat"></i> This application serves as a baseline for modernization to .NET Core with React/Angular using AWS Porting Assistant.
                </p>
            </div>
        </div>
    </div>
</div>
